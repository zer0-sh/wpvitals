<?xml version="1.0"?>
<ruleset name="WPVitals">
	<description>WordPress Coding Standards para el plugin WPVitals.</description>

	<file>.</file>

	<arg name="extensions" value="php" />
	<arg value="s" />

	<rule ref="WordPress" />

	<config name="minimum_supported_wp_version" value="6.5" />
	<config name="testVersion" value="7.4-8.5" />
	<config name="text_domain" value="wpvitals" />

	<!--
		El proyecto usa autoload PSR-4 (composer.json): el nombre de los
		archivos (ej. Checker.php) debe coincidir con la clase, incompatible
		con la convención class-*.php del sniff. Exclusión justificada.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
	</rule>

	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>docker/</exclude-pattern>
	<exclude-pattern>tests/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>\.github/</exclude-pattern>
	<!--
		wp-content/ aloja contenido local de WordPress (otros plugins)
		montado para pruebas; no es parte del código del plugin.
	-->
	<exclude-pattern>wp-content/</exclude-pattern>
	<exclude-pattern>*/\.git/*</exclude-pattern>
</ruleset>