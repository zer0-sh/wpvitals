#: includes/Checks/CronCheck.php:79
msgid "WP-Cron"
msgstr "WP-Cron"

#: includes/Checks/CronCheck.php:98
msgid "WP-Cron is disabled; make sure a system cron runs wp-cron.php instead of relying on visits."
msgstr "WP-Cron está deshabilitado; asegúrate de que un cron del sistema ejecuta wp-cron.php en lugar de depender de visitas."

#: includes/Checks/CronCheck.php:106
msgid "WP-Cron is disabled and no relevant events are detected; set up an external cron calling wp-cron.php or re-enable WP-Cron."
msgstr "WP-Cron está deshabilitado y no se detectan eventos relevantes; configura un cron externo que llame a wp-cron.php o reactiva WP-Cron."

#: includes/Checks/CronCheck.php:118
msgid "WP-Cron is active but no relevant events are detected; make sure the site receives traffic or run a scan to trigger scheduled tasks."
msgstr "WP-Cron está activo pero no se detectan eventos relevantes; revisa que el sitio reciba tráfico o ejecuta un escaneo para disparar las tareas programadas."

#: includes/Checks/DebugCheck.php:53
msgid "WordPress debug mode"
msgstr "Modo debug de WordPress"

#: includes/Checks/DebugCheck.php:72
msgid "WP_DEBUG and WP_DEBUG_DISPLAY are enabled; PHP errors can be shown in production. Disable them in wp-config.php."
msgstr "WP_DEBUG y WP_DEBUG_DISPLAY están activados; los errores PHP pueden mostrarse en producción. Desactívalos en wp-config.php."

#: includes/Checks/DebugCheck.php:80
msgid "WP_DEBUG is enabled in production; disable it in wp-config.php."
msgstr "WP_DEBUG está activado en producción; desactívalo en wp-config.php."

#: includes/Checks/DebugLogCheck.php:50
msgid "WordPress error log"
msgstr "Registro de errores de WordPress"

#: includes/Checks/DebugLogCheck.php:66
msgid "WP_DEBUG_LOG is enabled; the debug.log file can contain sensitive data and be publicly accessible. Disable it in production."
msgstr "WP_DEBUG_LOG está activado; el archivo debug.log puede contener datos sensibles y ser accesible públicamente. Desactívalo en producción."

#: includes/Checks/FileEditCheck.php:50
msgid "File editing from the admin"
msgstr "Edición de archivos desde el admin"

#: includes/Checks/FileEditCheck.php:66
msgid "File editing from WP-Admin is allowed; set DISALLOW_FILE_EDIT to true in wp-config.php."
msgstr "La edición de archivos desde WP-Admin está permitida; define DISALLOW_FILE_EDIT como true en wp-config.php."

#: includes/Checks/HttpsCheck.php:65
msgid "HTTPS connection"
msgstr "Conexión HTTPS"

#: includes/Checks/HttpsCheck.php:82
msgid "The current connection uses HTTPS."
msgstr "La conexión actual usa HTTPS."

#: includes/Checks/HttpsCheck.php:96
msgid "HTTPS is configured or enforced, but the current request is not detected as secure (possible reverse proxy or CDN); check the redirect and X-Forwarded-Proto headers."
msgstr "HTTPS está configurado o forzado, pero la petición actual no se detecta como segura (posible proxy inverso o CDN); verifica la redirección y los cabeceros X-Forwarded-Proto."

#: includes/Checks/HttpsCheck.php:106
msgid "The site does not enforce HTTPS; redirect all traffic to https and update the site URLs in WordPress settings."
msgstr "El sitio no fuerza HTTPS; redirige todo el tráfico a https y actualiza las URLs del sitio en los ajustes de WordPress."

#: includes/Checks/LoopbackCheck.php:68
msgid "Loopback requests"
msgstr "Peticiones loopback"

#: includes/Checks/LoopbackCheck.php:84
msgid "The loopback request failed (timeout or blocked connection); processes like cron, updates and email sending depend on it. Check firewalls, server rules and DNS."
msgstr "La petición loopback falló (timeout o conexión bloqueada); procesos como cron, actualizaciones y envíos de correo dependen de ella. Revisa firewalls, reglas del servidor y DNS."

#: includes/Checks/PhpDisplayErrorsCheck.php:49
msgid "PHP error display"
msgstr "Visualización de errores PHP"

#: includes/Checks/PhpDisplayErrorsCheck.php:65
msgid "display_errors is enabled and shows PHP errors to visitors. Disable it in production with display_errors = Off."
msgstr "display_errors está activado y muestra errores PHP a los visitantes. Desactívalo en producción con display_errors = Off."

#: includes/Checks/PhpExtensionsCheck.php:65
msgid "Required PHP extensions"
msgstr "Extensiones PHP requeridas"

#. translators: %s: list of required PHP extensions not found.
#: includes/Checks/PhpExtensionsCheck.php:89
#, php-format
msgid "Missing PHP extensions required by WordPress: %s. Install them for full functionality."
msgstr "Faltan extensiones PHP requeridas por WordPress: %s. Instálalas para un funcionamiento completo."

#: includes/Checks/PhpMemoryCheck.php:52
msgid "PHP memory limit"
msgstr "Límite de memoria de PHP"

#: includes/Checks/PhpMemoryCheck.php:66
msgid "memory_limit is set without a limit (unlimited)."
msgstr "memory_limit está configurado sin límite (ilimitado)."

#. translators: 1: current limit, 2: recommended limit.
#: includes/Checks/PhpMemoryCheck.php:79
#, php-format
msgid "memory_limit is at %1$s; WordPress recommends at least %2$s. Increase the limit in php.ini."
msgstr "memory_limit está en %1$s; WordPress recomienda al menos %2$s. Aumenta el límite en php.ini."

#: includes/Checks/PhpVersionCheck.php:80
msgid "PHP version"
msgstr "Versión de PHP"

#. translators: %s: detected PHP version.
#: includes/Checks/PhpVersionCheck.php:100
#, php-format
msgid "No lifecycle data available for PHP %s; check its official support status."
msgstr "No se dispone de datos del ciclo de vida para PHP %s; verifica su estado de soporte oficial."

#. translators: 1: PHP version, 2: EOL date.
#: includes/Checks/PhpVersionCheck.php:121
#, php-format
msgid "PHP %1$s ended security support on %2$s; update to a supported version."
msgstr "PHP %1$s finalizó su soporte de seguridad el %2$s; actualiza a una versión soportada."

#. translators: 1: PHP version, 2: EOL date.
#: includes/Checks/PhpVersionCheck.php:139
#, php-format
msgid "PHP %1$s will stop receiving security support on %2$s; plan the update."
msgstr "PHP %1$s dejará de recibir soporte de seguridad el %2$s; planifica la actualización."

#: includes/Checks/PluginsUpdatesCheck.php:65
msgid "Outdated plugins"
msgstr "Plugins desactualizados"

#: includes/Checks/PluginsUpdatesCheck.php:94
msgid "Outdated plugin"
msgstr "Plugin desactualizado"

#. translators: 1: plugin file, 2: new version, 3: updates URL.
#: includes/Checks/PluginsUpdatesCheck.php:102
#, php-format
msgid "Plugin %1$s has version %2$s available. Update it from the native updates screen: %3$s"
msgstr "El plugin %1$s tiene disponible la versión %2$s. Actualízalo desde la pantalla nativa de actualizaciones: %3$s"

#: includes/Checks/SecurityHeadersCheck.php:114
#: includes/Checks/SecurityHeadersCheck.php:155
msgid "Could not fetch the site headers; check the HTTP request."
msgstr "No se pudieron consultar las cabeceras del sitio; revisa la petición HTTP."

#. translators: %d: number of missing headers.
#: includes/Checks/SecurityHeadersCheck.php:133
#, php-format
msgid "%d security headers missing on the public homepage."
msgstr "%d cabeceras de seguridad ausentes en la portada pública."

#: includes/Checks/SecurityHeadersCheck.php:197
msgid "X-Content-Type-Options header"
msgstr "Cabecera X-Content-Type-Options"

#: includes/Checks/SecurityHeadersCheck.php:198
msgid "X-Content-Type-Options: nosniff is missing; add it to prevent browser MIME sniffing."
msgstr "No se detecta X-Content-Type-Options: nosniff; añádela para impedir el MIME sniffing del navegador."

#: includes/Checks/SecurityHeadersCheck.php:201
msgid "X-Frame-Options header"
msgstr "Cabecera X-Frame-Options"

#: includes/Checks/SecurityHeadersCheck.php:202
msgid "X-Frame-Options is missing (and no frame-ancestors in the CSP); it prevents clickjacking of your site."
msgstr "No se detecta X-Frame-Options (ni frame-ancestors en la CSP); previene el clickjacking de tu sitio."

#: includes/Checks/SecurityHeadersCheck.php:205
msgid "Content-Security-Policy header"
msgstr "Cabecera Content-Security-Policy"

#: includes/Checks/SecurityHeadersCheck.php:206
msgid "Content-Security-Policy is missing; define a policy that limits allowed origins and resources."
msgstr "No se detecta Content-Security-Policy; define una política que limite los orígenes y recursos permitidos."

#: includes/Checks/SecurityHeadersCheck.php:209
msgid "Referrer-Policy header"
msgstr "Cabecera Referrer-Policy"

#: includes/Checks/SecurityHeadersCheck.php:210
msgid "Referrer-Policy is missing; configure how much referrer information is shared with other sites."
msgstr "No se detecta Referrer-Policy; configura cuánta información de referencia se filtra a otros sitios."

#: includes/Checks/SecurityHeadersCheck.php:213
msgid "Permissions-Policy header"
msgstr "Cabecera Permissions-Policy"

#: includes/Checks/SecurityHeadersCheck.php:214
msgid "Permissions-Policy is missing; restrict the browser APIs (camera, microphone, geolocation…) available on your pages."
msgstr "No se detecta Permissions-Policy; restringe las APIs del navegador (cámara, micro, geolocalización…) disponibles en tus páginas."

#: includes/Checks/SecurityHeadersCheck.php:217
msgid "Strict-Transport-Security header"
msgstr "Cabecera Strict-Transport-Security"

#: includes/Checks/SecurityHeadersCheck.php:218
msgid "Strict-Transport-Security is missing; over HTTPS it forces secure connections and prevents downgrade attacks."
msgstr "No se detecta Strict-Transport-Security; sobre HTTPS fuerza conexiones seguras y previene ataques de degradación."

#: includes/Checks/ThemesUpdatesCheck.php:67
msgid "Outdated themes"
msgstr "Temas desactualizados"

#: includes/Checks/ThemesUpdatesCheck.php:96
msgid "Outdated theme"
msgstr "Tema desactualizado"

#. translators: 1: theme slug, 2: new version, 3: updates URL.
#: includes/Checks/ThemesUpdatesCheck.php:104
#, php-format
msgid "Theme %1$s has version %2$s available. Update it from the native updates screen: %3$s"
msgstr "El tema %1$s tiene disponible la versión %2$s. Actualízalo desde la pantalla nativa de actualizaciones: %3$s"

#: includes/Checks/WordPressVersionCheck.php:93
msgid "WordPress version"
msgstr "Versión de WordPress"

#: includes/Checks/WordPressVersionCheck.php:112
msgid "Could not fetch the available stable WordPress version; check the site update cache."
msgstr "No se pudo obtener la versión estable disponible de WordPress; revisa la caché de actualizaciones del sitio."

#: includes/Checks/WordPressVersionCheck.php:129
msgid "WordPress is up to date, but automatic updates are disabled; enable them to receive security patches."
msgstr "WordPress está actualizado, pero las actualizaciones automáticas están deshabilitadas; actívalas para recibir parches de seguridad."

#. translators: 1: installed version, 2: available stable version.
#: includes/Checks/WordPressVersionCheck.php:142
#, php-format
msgid "A WordPress update is pending (installed %1$s, available %2$s). Run the update from the admin."
msgstr "Hay una actualización de WordPress pendiente (instalado %1$s, disponible %2$s). Ejecuta la actualización desde el admin."

#. translators: 1: installed version, 2: available stable version.
#: includes/Checks/WordPressVersionCheck.php:155
#, php-format
msgid "WordPress %1$s is outdated and automatic updates are disabled; update to %2$s and enable auto-updates."
msgstr "WordPress %1$s está desactualizado y las actualizaciones automáticas están deshabilitadas; actualiza a %2$s y activa los auto-updates."

#: includes/Checks/XmlRpcCheck.php:50
msgid "XML-RPC"
msgstr "XML-RPC"

#: includes/Checks/XmlRpcCheck.php:66
msgid "XML-RPC is enabled and used in brute-force attacks. Disable it by returning false from the xmlrpc_enabled filter or blocking xmlrpc.php."
msgstr "XML-RPC está habilitado y se usa en ataques de fuerza bruta. Desactívalo devolviendo false desde el filtro xmlrpc_enabled o bloqueando xmlrpc.php."

#: includes/MailReport.php:165
msgid "Findings:"
msgstr "Hallazgos:"

#. translators: %d: number of additional findings.
#: includes/MailReport.php:185
#, php-format
msgid "…and %d more findings."
msgstr "…y %d hallazgos más."

#. translators: 1: source name (e.g. CVE-2024-12345), 2: severity.
#: includes/Scanner.php:248
#, php-format
msgid "Vulnerability %1$s with %2$s severity. Update the component to a secure version."
msgstr "Vulnerabilidad %1$s de severidad %2$s. Actualiza el componente a una versión segura."
